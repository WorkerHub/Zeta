{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on monday"],
  "timezone": "UTC",
  "automerge": false,
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    },
    {
      "groupName": "Cloudflare packages",
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "matchPackageNames": [
        "/^@cloudflare//"
      ]
    },
    {
      "groupName": "SimpleWebAuthn packages",
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "matchPackageNames": [
        "/^@simplewebauthn//"
      ]
    },
    {
      "groupName": "CodeMirror packages",
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "matchPackageNames": [
        "/^@codemirror//",
        "/^@uiw/react-codemirror$/",
        "/^codemirror$/"
      ]
    },
    {
      "groupName": "React ecosystem",
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "matchPackageNames": [
        "/^react$/",
        "/^react-dom$/",
        "/^react-router-dom$/"
      ]
    },
    {
      "groupName": "Build tooling",
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "matchPackageNames": [
        "/^typescript$/",
        "/^vite$/",
        "/^vitest$/",
        "/^@vitejs/plugin-react$/",
        "/^tailwindcss$/",
        "/^@tailwindcss/vite$/"
      ]
    }
  ]
}
